{
  "name": "Njabulo-Jb",
  "version": "2.0.0",
  "description": "NJABULO-JB WhatsApp Bot - Fast & Reliable",
  "main": "control.js",
  "scripts": {
    "test": "node control.js",
    "s": "node control.js",
    "start": "node control.js",
    "toshtech": "pm2 start control.js --attach",
    "c": "tsc",
    "dev": "nodemon control.js",
    "pm2:start": "pm2 start control.js --name njabulo --max-memory-restart 500M",
    "pm2:stop": "pm2 stop njabulo",
    "pm2:restart": "pm2 restart njabulo",
    "pm2:logs": "pm2 logs njabulo",
    "pm2:monit": "pm2 monit",
    "keepalive": "node keepalive.js",
    "postinstall": "npm rebuild --update-binary || echo 'Build completed with warnings'",
    "build": "npm install --legacy-peer-deps",
    "docker-start": "pm2-runtime control.js --name njabulo"
  },
  "keywords": [
    "bot",
    "Baileys",
    "Njabulo-Jb",
    "whatsapp",
    "whatsapp-bot",
    "fana-md-boy"
  ],
  "author": "NjabuloJf",
  "license": "ISC",
